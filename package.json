{
  "name": "accordion-tools",
  "private": true,
  "version": "0.22.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:analyze": "tsc -b && vite build --manifest && node scripts/audit-production-bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:chords": "vitest run tests/unit/chords",
    "test:harmony": "vitest run tests/unit/harmony",
    "test:patterns": "vitest run tests/unit/patterns",
    "test:notation": "vitest run tests/unit/notation",
    "test:abc": "vitest run tests/unit/abc",
    "test:rhythm": "vitest run tests/unit/rhythm",
    "test:i18n": "vitest run tests/unit/i18n",
    "test:display": "vitest run tests/unit/display",
    "test:audio": "vitest run tests/unit/audio",
    "test:modules": "vitest run tests/unit/modules",
    "test:release": "vitest run tests/unit/release",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "verify:release": "npm run lint && npm run test && npm run build:analyze"
  },
  "dependencies": {
    "abcjs": "^6.6.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^5.1.0"
  }
}
