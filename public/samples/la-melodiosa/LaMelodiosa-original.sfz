<control>
//image=Ui/Cover.jpg
label_cc20=Bass selector
label_cc21=Treble selector
default_path=LAMelodiosa/

<global>
ampeg_release=0.4
amp_veltrack=60

<group>
#define DO_DISABLE 1
#define VELHI 80
#define VELLO 81
master_label=Accordion-La-Melodiosa

//Bass Voice 1
<group>
	lokey=C3  hikey=D3
	locc20=0  hicc20=41
	amplitude=100
	<region>  sample=BS-C#5-ba.wav  pitch_keycenter=C#3  tune=-3

<group>
	lokey=G3  hikey=G#3
	locc20=0  hicc20=41
	amplitude=100
	<region>  sample=BS-G#5-ba.wav  pitch_keycenter=G#3  tune=-7

