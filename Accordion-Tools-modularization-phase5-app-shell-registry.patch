new file mode 100644
index 0000000..422a3f5
--- /dev/null
+++ b/src/app/components/WorkspaceToolbar.tsx
@@ -0,0 +1,217 @@
+import { useEffect, useRef } from "react";
+import type { Side, LeftPanelMode, DownloadFormat } from "../../types";
+import type { useLanguageSettings } from "../../settings/useLanguageSettings";
+import type { ToolSection, WorkspaceMode } from "../toolRegistry";
+import { SegmentedChoice } from "../../components/ui/SegmentedChoice";
+
+/** Presentational toolbar. Callbacks must retain App's stop/cancel and reset ordering. */
+export type WorkspaceToolbarProps = {
+  t: ReturnType<typeof useLanguageSettings>["t"];
+  workspaceMode: WorkspaceMode;
+  side: Side;
+  leftPanelMode: LeftPanelMode;
+  activeToolSection: ToolSection;
+  onSelectStradella: () => void;
+  onSelectTreble: () => void;
+  onSelectHarmony: () => void;
+  onShowSettings: () => void;
+  onShowTools: () => void;
+  onToggleFocus: () => void;
+  bassPatternEvents: readonly unknown[];
+  bassPatternRenderedNotationVisible: boolean;
+  onToggleBassPatternNotation: () => void;
+  harmonyRecordedProgression: readonly unknown[];
+  harmonyRecordedNotationVisible: boolean;
+  onToggleHarmonyRecordedNotation: () => void;
+  harmonyProgressionPlayable: boolean;
+  harmonyProgressionNotationVisible: boolean;
+  onToggleHarmonyProgressionNotation: () => void;
+  abcText: string;
+  abcRenderedNotationVisible: boolean;
+  onToggleAbcNotation: () => void;
+  sequenceStepsWithButtons: readonly unknown[];
+  sequenceRenderedNotationVisible: boolean;
+  onToggleSequenceNotation: () => void;
+  soundEnabled: boolean;
+  onToggleSound: () => void;
+  onClearWork: () => void;
+  onRestoreToolDefaults: () => void;
+  downloadFormat: DownloadFormat;
+  setDownloadFormat: (format: DownloadFormat) => void;
+  onDownloadDiagram: () => void;
+};
+
+export function WorkspaceToolbar({
+  t, workspaceMode, side, leftPanelMode, activeToolSection,
+  onSelectStradella, onSelectTreble, onSelectHarmony, onShowSettings, onShowTools, onToggleFocus,
+  bassPatternEvents, bassPatternRenderedNotationVisible, onToggleBassPatternNotation,
+  harmonyRecordedProgression, harmonyRecordedNotationVisible, onToggleHarmonyRecordedNotation,
+  harmonyProgressionPlayable, harmonyProgressionNotationVisible, onToggleHarmonyProgressionNotation,
+  abcText, abcRenderedNotationVisible, onToggleAbcNotation,
+  sequenceStepsWithButtons, sequenceRenderedNotationVisible, onToggleSequenceNotation,
+  soundEnabled, onToggleSound, onClearWork, onRestoreToolDefaults,
+  downloadFormat, setDownloadFormat, onDownloadDiagram,
+}: WorkspaceToolbarProps) {
+  const resetMenuRef = useRef<HTMLDetailsElement | null>(null);
+  useEffect(() => {
+    function closeOnOutside(event: PointerEvent) {
+      if (resetMenuRef.current?.open && !resetMenuRef.current.contains(event.target as Node))
+        resetMenuRef.current.open = false;
+    }
+    function closeOnEscape(event: KeyboardEvent) {
+      if (event.key === "Escape" && resetMenuRef.current?.open) {
+        resetMenuRef.current.open = false;
+        resetMenuRef.current.querySelector("summary")?.focus();
+      }
+    }
+    document.addEventListener("pointerdown", closeOnOutside);
+    document.addEventListener("keydown", closeOnEscape);
+    return () => {
+      document.removeEventListener("pointerdown", closeOnOutside);
+      document.removeEventListener("keydown", closeOnEscape);
+    };
+  }, []);
+  return (
+        <div className="topbar">
+          <button
+            className={`topbar-button ${workspaceMode === "accordion" && side === "stradella" ? "active" : ""}`}
+            onClick={onSelectStradella}
+          >
+            {t("nav.stradella")}
+          </button>
+
+          <button
+            className={`topbar-button ${workspaceMode === "accordion" && side === "treble" ? "active" : ""}`}
+            onClick={onSelectTreble}
+          >
+            {t("nav.treble")}
+          </button>
+
+          <button
+            className={`topbar-button ${workspaceMode === "harmony" ? "active" : ""}`}
+            onClick={onSelectHarmony}
+          >
+            {t("nav.harmony")}
+          </button>
+
+          <span className="topbar-separator" />
+
+          <button
+            className={`topbar-button ${leftPanelMode === "settings" ? "active" : ""}`}
+            onClick={onShowSettings}
+          >
+            {t("nav.settings")}
+          </button>
+
+          <button
+            className={`topbar-button ${leftPanelMode === "tools" ? "active" : ""}`}
+            onClick={onShowTools}
+          >
+            {t("nav.tools")}
+          </button>
+
+          <button
+            className={`topbar-button ${leftPanelMode === "hidden" ? "active" : ""}`}
+            onClick={onToggleFocus}
+            title={t("nav.focusHint")}
+          >
+            {leftPanelMode === "hidden" ? t("nav.showControls") : t("nav.focusDiagram")}
+          </button>
+
+          {workspaceMode === "accordion" &&
+            side === "stradella" &&
+            activeToolSection === "bassPatternPlayer" &&
+            bassPatternEvents.length > 0 && (
+              <>
+                <button
+                  className={`topbar-button ${bassPatternRenderedNotationVisible ? "active" : ""}`}
+                  onClick={onToggleBassPatternNotation}
+                >
+                  {bassPatternRenderedNotationVisible ? t("ui.hideNotation") : t("ui.showNotation")}
+                </button>
+              </>
+            )}
+
+          {workspaceMode === "harmony" && harmonyRecordedProgression.length > 0 && (
+            <button
+              className={`topbar-button ${harmonyRecordedNotationVisible ? "active" : ""}`}
+              onClick={onToggleHarmonyRecordedNotation}
+            >
+              {harmonyRecordedNotationVisible ? t("ui.hideNotation") : t("ui.showNotation")}
+            </button>
+          )}
+
+          {workspaceMode === "accordion" &&
+            side === "stradella" &&
+            activeToolSection === "progressionAssistant" &&
+            harmonyProgressionPlayable && (
+              <button
+                className={`topbar-button ${harmonyProgressionNotationVisible ? "active" : ""}`}
+                onClick={onToggleHarmonyProgressionNotation}
+              >
+                {harmonyProgressionNotationVisible ? t("ui.hideNotation") : t("ui.showNotation")}
+              </button>
+            )}
+
+          {workspaceMode === "accordion" && activeToolSection === "abcPlayer" && abcText.trim() && (
+            <button
+              className={`topbar-button ${abcRenderedNotationVisible ? "active" : ""}`}
+              onClick={onToggleAbcNotation}
+            >
+              {abcRenderedNotationVisible ? t("ui.hideNotation") : t("ui.showNotation")}
+            </button>
+          )}
+
+          {workspaceMode === "accordion" && activeToolSection === "sequences" &&
+            sequenceStepsWithButtons.length > 0 && (
+              <button
+                className={`topbar-button ${sequenceRenderedNotationVisible ? "active" : ""}`}
+                onClick={onToggleSequenceNotation}
+              >
+                {sequenceRenderedNotationVisible ? t("ui.hideNotation") : t("ui.showNotation")}
+              </button>
+            )}
+
+          <span className="topbar-spacer" />
+
+          <button
+            className={`topbar-button ${soundEnabled ? "active" : ""}`}
+            onClick={onToggleSound}
+          >
+            {soundEnabled ? t("ui.soundOn") : t("ui.soundOff")}
+          </button>
+
+          <details ref={resetMenuRef} className="reset-menu">
+            <summary className="topbar-button reset-button" title={t("ui.resetScope")}>
+              {t("ui.reset")} <span aria-hidden="true">▾</span>
+            </summary>
+            <div className="reset-menu-options">
+              <button type="button" onClick={(event) => {
+                onClearWork();
+                event.currentTarget.closest("details")?.removeAttribute("open");
+              }}>{t("ui.clearCurrentWork")}</button>
+              {(workspaceMode === "harmony" || (side === "stradella" && activeToolSection === "stradellaChordFinder")) && (
+                <button type="button" onClick={(event) => {
+                  onRestoreToolDefaults();
+                  event.currentTarget.closest("details")?.removeAttribute("open");
+                }}>{t("ui.restoreToolDefaults")}</button>
+              )}
+            </div>
+          </details>
+
+          <span className="topbar-after-reset-space" aria-hidden="true" />
+
+          <div className="topbar-format-choice">
+            <SegmentedChoice label={t("ui.downloadFormat")} value={downloadFormat} onChange={setDownloadFormat}
+              options={[{ value: "svg", label: "SVG" }, { value: "png", label: "PNG" }]} />
+          </div>
+
+          <button
+            className="topbar-button download-button"
+            onClick={onDownloadDiagram}
+          >
+            {t("ui.downloadKind", { kind: downloadFormat.toUpperCase() })}
+          </button>
+        </div>
+  );
+}
diff --git a/src/app/toolRegistry.ts b/src/app/toolRegistry.ts
new file mode 100644
index 0000000..d2383e7
--- /dev/null
+++ b/src/app/toolRegistry.ts
@@ -0,0 +1,33 @@
+/** Registry of currently implemented tool sections.
+ *
+ * The navigation contract is intentionally independent of musical engines,
+ * panel imports and sound. It does not yet determine lazy-loaded components.
+ * `defaultSide` is applied when a command explicitly opens a tool; existing
+ * accordion-section toggles retain their historical side behavior.
+ */
+export const TOOL_REGISTRY = {
+  scaleFinder: { workspace: "accordion", category: "finder" },
+  chordFinder: { workspace: "accordion", category: "finder" },
+  abcPlayer: { workspace: "accordion", category: "player" },
+  bassPatternPlayer: { workspace: "accordion", category: "player" },
+  stradellaChordFinder: { workspace: "accordion", category: "finder", defaultSide: "stradella" },
+  harmonyExplorer: { workspace: "harmony", category: "harmony" },
+  progressionAssistant: { workspace: "accordion", category: "harmony", defaultSide: "stradella" },
+  fingering: { workspace: "accordion", category: "diagram" },
+  selection: { workspace: "accordion", category: "diagram" },
+  sequences: { workspace: "accordion", category: "diagram" },
+  annotateDiagram: { workspace: "accordion", category: "diagram" },
+} as const;
+
+export type ToolId = keyof typeof TOOL_REGISTRY;
+export type ToolSection = ToolId | null;
+export type WorkspaceMode = "accordion" | "harmony";
+
+/** A missing default side means the tool leaves the current instrument side unchanged. */
+export function toolDestination(tool: ToolId): { workspace: WorkspaceMode; defaultSide?: "stradella" } {
+  const definition = TOOL_REGISTRY[tool];
+  return {
+    workspace: definition.workspace,
+    ...("defaultSide" in definition ? { defaultSide: definition.defaultSide } : {}),
+  };
+}
diff --git a/src/app/useWorkspaceNavigation.ts b/src/app/useWorkspaceNavigation.ts
new file mode 100644
index 0000000..f845ee3
--- /dev/null
+++ b/src/app/useWorkspaceNavigation.ts
@@ -0,0 +1,66 @@
+import { useEffect, useState, type Dispatch, type SetStateAction } from "react";
+import type { LeftPanelMode, Side } from "../types";
+import { toolDestination, type ToolId, type ToolSection, type WorkspaceMode } from "./toolRegistry";
+
+export type SettingsSection = "instrument" | "title" | "appearance" | "notation" |
+  "musicNotation" | "sound" | "harmony" | "about" | null;
+
+/** Workspace/UI navigation; instrument layout stays with the instrument hook.
+ * Musical tool state, playback cancellation and selection transfer remain owned
+ * by their feature controllers and the App command handlers, respectively.
+ */
+export function useWorkspaceNavigation(side: Side, setSide: Dispatch<SetStateAction<Side>>) {
+  const [leftPanelMode, setLeftPanelMode] = useState<LeftPanelMode>("tools");
+  const [workspaceMode, setWorkspaceMode] = useState<WorkspaceMode>("accordion");
+  const [activeSettingsSection, setActiveSettingsSection] = useState<SettingsSection>(null);
+  const [activeToolSection, setActiveToolSection] = useState<ToolSection>(null);
+
+  useEffect(() => {
+    // eslint-disable-next-line react-hooks/set-state-in-effect -- Preserve the original settings-close behavior on workspace/instrument changes.
+    setActiveSettingsSection(null);
+  }, [workspaceMode, side]);
+
+  function toggleSettingsSection(section: Exclude<SettingsSection, null>) {
+    setActiveSettingsSection(current => current === section ? null : section);
+  }
+
+  function toggleToolSection(tool: ToolId) {
+    setWorkspaceMode(toolDestination(tool).workspace);
+    // Historical accordion behavior: only Progression Assistant forces Stradella.
+    if (tool === "progressionAssistant") setSide("stradella");
+    setActiveToolSection(current => current === tool ? null : tool);
+  }
+
+  /** Command navigation, unlike accordion toggling, always exposes its target.
+   * The caller continues to own any cross-tool data transfer and audio stops.
+   */
+  function navigateToTool(tool: ToolId, options: { side?: Side; showTools?: boolean } = {}) {
+    const destination = toolDestination(tool);
+    setWorkspaceMode(destination.workspace);
+    const nextSide = options.side ?? destination.defaultSide;
+    if (nextSide) setSide(nextSide);
+    if (options.showTools !== false) setLeftPanelMode("tools");
+    setActiveToolSection(tool);
+  }
+
+  function selectAccordionSide(nextSide: Side) {
+    setWorkspaceMode("accordion");
+    setSide(nextSide);
+  }
+
+  function setPanel(mode: Exclude<LeftPanelMode, "hidden">) {
+    setLeftPanelMode(current => current === mode ? "hidden" : mode);
+  }
+
+  function toggleFocusPanel() {
+    setLeftPanelMode(current => current === "hidden"
+      ? (workspaceMode === "harmony" ? "tools" : "settings") : "hidden");
+  }
+
+  return {
+    leftPanelMode, setLeftPanelMode, workspaceMode, setWorkspaceMode,
+    activeSettingsSection, setActiveSettingsSection, activeToolSection, setActiveToolSection,
+    toggleSettingsSection, toggleToolSection, navigateToTool,
+    selectAccordionSide, setPanel, toggleFocusPanel,
+  };
+}
