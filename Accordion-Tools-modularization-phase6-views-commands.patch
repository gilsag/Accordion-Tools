+    if (kind === "chord-minor") return MINOR_FUNCTION_REF[d] ?? "i";
+    if (kind === "chord-dominant7") return (MAJOR_FUNCTION_REF[d] ?? "I") + "7";
+    if (kind === "chord-diminished7") return (MINOR_FUNCTION_REF[d] ?? "i") + "°7";
