+assert.match(glyphs, /toggleButton\(button\)/);
+assert.match(glyphs, /"piano-black-key"/);
+assert.match(glyphs, /"finder-root-bass"/);
+assert.match(glyphs, /"annotation-anchor-placeholder"/);
