@@ -0,0 +1,54 @@
+import { useMemo, useState } from "react";
+import type { SoundSource, SoundVoicePreset, SoundWaveform, SampleRegister, StradellaBassVoicing } from "../types";
+import type { StradellaRegisterModel } from "../tools/stradellaChordFinder/registerModel";
+import type { SoundOptions } from "../sound";
+
+/** Owns audio preferences independently of instrument geometry and registers.
+ * The opt-in La Melodiosa register adapter is applied in SoundOptions, never
+ * by altering the nominal Stradella instrument model or its stored keys.
+ */
+export function useSoundSettings(stradellaRegisterModel: StradellaRegisterModel) {
+  /* Sound tool state for synthesized button and sequence playback. */
+  const [soundEnabled, setSoundEnabled] = useState(true);
+  const [soundVolume, setSoundVolume] = useState(0.2);
+  const [soundSource, setSoundSource] = useState<SoundSource>("la-melodiosa");
+  const [laMelodiosaTrebleRegister, setLaMelodiosaTrebleRegister] =
+    useState<SampleRegister>("I");
+  const [laMelodiosaBassRegister, setLaMelodiosaBassRegister] =
+    useState<SampleRegister>("III");
+  const [laMelodiosaFollowStradellaRegisters, setLaMelodiosaFollowStradellaRegisters] = useState(true);
+  const [soundVoicePreset, setSoundVoicePreset] =
+    useState<SoundVoicePreset>("soft-reed");
+  const [soundWaveform, setSoundWaveform] = useState<SoundWaveform>("triangle");
+  const [soundMusetteDetuneCents, setSoundMusetteDetuneCents] = useState(9);
+  const [soundAttackMs, setSoundAttackMs] = useState(14);
+  const [soundReleaseMs, setSoundReleaseMs] = useState(120);
+  const [soundNoteDurationMs, setSoundNoteDurationMs] = useState(420);
+  const [soundSequenceTempoBpm, setSoundSequenceTempoBpm] = useState(80);
+  const [stradellaBassVoicing, setStradellaBassVoicing] =
+    useState<StradellaBassVoicing>("single-low");
+  /* Consolidated sound options passed to the Web Audio helper functions. */
+  const soundOptions: SoundOptions = useMemo(() => ({
+    enabled: soundEnabled,
+    volume: soundVolume,
+    source: soundSource,
+    laMelodiosaTrebleRegister,
+    laMelodiosaBassRegister,
+    laMelodiosaFollowStradellaRegisters,
+    stradellaRegisterModel,
+    voicePreset: soundVoicePreset,
+    waveform: soundWaveform,
+    musetteDetuneCents: soundMusetteDetuneCents,
+    attackMs: soundAttackMs,
+    releaseMs: soundReleaseMs,
+    noteDurationMs: soundNoteDurationMs,
+    sequenceTempoBpm: soundSequenceTempoBpm,
+    stradellaBassVoicing,
+  }), [
+    soundEnabled, soundVolume, soundSource, laMelodiosaTrebleRegister, laMelodiosaBassRegister,
+    laMelodiosaFollowStradellaRegisters, stradellaRegisterModel, soundVoicePreset, soundWaveform, soundMusetteDetuneCents,
+    soundAttackMs, soundReleaseMs, soundNoteDurationMs, soundSequenceTempoBpm, stradellaBassVoicing,
+  ]);
+
+  return { soundEnabled, setSoundEnabled, soundVolume, setSoundVolume, soundSource, setSoundSource, laMelodiosaTrebleRegister, setLaMelodiosaTrebleRegister, laMelodiosaBassRegister, setLaMelodiosaBassRegister, laMelodiosaFollowStradellaRegisters, setLaMelodiosaFollowStradellaRegisters, soundVoicePreset, setSoundVoicePreset, soundWaveform, setSoundWaveform, soundMusetteDetuneCents, setSoundMusetteDetuneCents, soundAttackMs, setSoundAttackMs, soundReleaseMs, setSoundReleaseMs, soundNoteDurationMs, setSoundNoteDurationMs, soundSequenceTempoBpm, setSoundSequenceTempoBpm, stradellaBassVoicing, setStradellaBassVoicing, soundOptions };
+}
diff --git a/src/diagram/components/DiagramAnnotationsLayer.tsx b/src/diagram/components/DiagramAnnotationsLayer.tsx
new file mode 100644
--- /dev/null
+++ b/src/diagram/components/DiagramAnnotationsLayer.tsx
@@ -0,0 +1,101 @@
+import type { TextNote } from "../../types";
+import type { useDiagramAnnotations } from "../../features/annotateDiagram/useDiagramAnnotations";
+import { fontClass } from "../../music";
+import { splitMultilineText } from "../../tools/textNoteTools";
+
+type EditorController = ReturnType<typeof useDiagramAnnotations>;
+type DiagramAnnotationsLayerProps = {
+  textNotes: TextNote[];
+  inlineAnnotationEditor: EditorController["inlineAnnotationEditor"];
+  setInlineAnnotationEditor: EditorController["setInlineAnnotationEditor"];
+  annotationEditorRef: EditorController["annotationEditorRef"];
+  commitInlineAnnotation: EditorController["commitInlineAnnotation"];
+  cancelInlineAnnotation: EditorController["cancelInlineAnnotation"];
+  viewWidth: number;
+  viewHeight: number;
+  annotationPlaceholder: string;
+};
+
+/** Render saved SVG text and the interactive editor in the original SVG
+ * coordinate system. The editor remains excluded from SVG/PNG serialization.
+ */
+export function DiagramAnnotationsLayer({textNotes, inlineAnnotationEditor,
+  setInlineAnnotationEditor, annotationEditorRef, commitInlineAnnotation,
+  cancelInlineAnnotation, viewWidth, viewHeight, annotationPlaceholder,
+}: DiagramAnnotationsLayerProps) {
+  return <>
+            {textNotes.map((note) => (
+              <text
+                key={note.id}
+                x={note.x}
+                y={note.y}
+                textAnchor={note.anchor}
+                className={`free-text-note ${fontClass(note.font)}`}
+                style={{
+                  fontSize: note.fontSize,
+                  fill: note.color,
+                  fontWeight: note.bold ? 800 : 500,
+                  fontStyle: note.italic ? "italic" : undefined,
+                }}
+              >
+                {splitMultilineText(note.text).map((line, index) => (
+                  <tspan
+                    key={index}
+                    x={note.x}
+                    dy={index === 0 ? 0 : note.fontSize * 1.25}
+                  >
+                    {line || " "}
+                  </tspan>
+                ))}
+              </text>
+            ))}
+
+            {inlineAnnotationEditor && (() => {
+              const editorWidth = 180;
+              const editorHeight = 68;
+              const editorX = Math.max(8, Math.min(inlineAnnotationEditor.x - editorWidth / 2, viewWidth - editorWidth - 8));
+              const editorY = Math.max(8, Math.min(inlineAnnotationEditor.y - editorHeight / 2, viewHeight - editorHeight - 8));
+
+              return (
+                <foreignObject
+                  x={editorX}
+                  y={editorY}
+                  width={editorWidth}
+                  height={editorHeight}
+                  className="annotation-editor-object"
+                  onClick={(event) => event.stopPropagation()}
+                >
+                  <div className="annotation-editor">
+                    <textarea
+                      ref={annotationEditorRef}
+                      value={inlineAnnotationEditor.text}
+                      placeholder={annotationPlaceholder}
+                      style={{
+                        fontSize: inlineAnnotationEditor.fontSize,
+                        color: inlineAnnotationEditor.color,
+                        fontWeight: inlineAnnotationEditor.bold ? 800 : 500,
+                        fontStyle: inlineAnnotationEditor.italic ? "italic" : undefined,
+                      }}
+                      onChange={(event) =>
+                        setInlineAnnotationEditor((current) =>
+                          current ? { ...current, text: event.target.value } : current,
+                        )
+                      }
+                      onKeyDown={(event) => {
+                        if (event.key === "Enter" && !event.shiftKey) {
+                          event.preventDefault();
+                          commitInlineAnnotation();
+                        }
+                        if (event.key === "Escape") {
+                          event.preventDefault();
+                          cancelInlineAnnotation();
+                        }
+                      }}
+                      onBlur={commitInlineAnnotation}
+                    />
+                  </div>
+                </foreignObject>
+              );
+            })()}
+  </>;
+}
diff --git a/src/diagram/components/DiagramButtonLayer.tsx b/src/diagram/components/DiagramButtonLayer.tsx
new file mode 100644
--- /dev/null
+++ b/src/diagram/components/DiagramButtonLayer.tsx
@@ -0,0 +1,305 @@
+import type { DiagramButton, Overlay, SequenceStep, ChordLabelMode, FontFamily, NumberPosition, DiagramAnnotationAnchor } from "../../types";
+import { fontClass, isChordKind, isAccidentalPitch, renderMusicLabel } from "../../music";
+import { getSequenceLabelsForButton } from "../../tools/sequenceTools";
+
+/** One DOM-preserving drawing boundary for the physical keys/buttons, overlays,
+ * Finder highlights and fingering. Playback still uses its own playbackButtons:
+ * no rendered highlight is treated as a sounding note here.
+ */
+type DiagramButtonLayerProps = {
+  buttons: DiagramButton[];
+  overlays: Record<string, Overlay>;
+  sequenceSteps: SequenceStep[];
+  scaleFinderButtons: DiagramButton[];
+  finderButtonIds: ReadonlySet<string>;
+  progressionPreviewButtonIds: ReadonlySet<string>;
+  abcActiveButtonIdSet: ReadonlySet<string>;
+  bassPatternActiveButtonIdSet: ReadonlySet<string>;
+  harmonyProgressionActiveButtonIdSet: ReadonlySet<string>;
+  stradellaChordFinderActive: boolean;
+  stradellaPrimaryFinderButtonIds: ReadonlySet<string>;
+  stradellaRootBassFinderButtonIds: ReadonlySet<string>;
+  getMainLabel: (button: DiagramButton) => string;
+  toggleButton: (button: DiagramButton) => void;
+  buttonSize: number;
+  chordLabelMode: ChordLabelMode;
+  showScaleFinderNumbers: boolean;
+  labelFontSize: number;
+  showButtonLabels: boolean;
+  labelFont: FontFamily;
+  showSequenceNumbers: boolean;
+  sequenceNumberPosition: NumberPosition;
+  annotationActive: boolean;
+  annotationPointForButton: (button: DiagramButton, anchor: DiagramAnnotationAnchor) => { x: number; y: number };
+  annotationButtonAnchor: DiagramAnnotationAnchor;
+  fingeringPosition: NumberPosition;
+};
+
+function finderLabelsForButton(buttons: DiagramButton[], buttonId: string) {
+  return buttons
+    .map((button, index) => (button.id === buttonId ? String(index + 1) : ""))
+    .filter(Boolean)
+    .join(",");
+}
+
+/** Calculates the y-coordinate for a sequence number relative to a button. */
+function numberY(
+  buttonY: number,
+  buttonSize: number,
+  position: NumberPosition,
+) {
+  if (position === "above") return buttonY - buttonSize * 0.72;
+  if (position === "inside-top") return buttonY - buttonSize * 0.48;
+  return buttonY + buttonSize * 0.58;
+}
+
+/** Calculates the y-coordinate for a fingering label relative to a button. */
+function fingeringY(
+  buttonY: number,
+  buttonSize: number,
+  position: NumberPosition,
+) {
+  if (position === "above") return buttonY - buttonSize * 0.72;
+  if (position === "inside-top") return buttonY - buttonSize * 0.48;
+  return buttonY + buttonSize * 0.58;
+}
+
+export function DiagramButtonLayer({ buttons, overlays, sequenceSteps, scaleFinderButtons, finderButtonIds,
+  progressionPreviewButtonIds, abcActiveButtonIdSet, bassPatternActiveButtonIdSet,
+  harmonyProgressionActiveButtonIdSet, stradellaChordFinderActive,
+  stradellaPrimaryFinderButtonIds, stradellaRootBassFinderButtonIds,
+  getMainLabel, toggleButton, buttonSize, chordLabelMode, showScaleFinderNumbers,
+  labelFontSize, showButtonLabels, labelFont, showSequenceNumbers,
+  sequenceNumberPosition, annotationActive, annotationPointForButton,
+  annotationButtonAnchor, fingeringPosition }: DiagramButtonLayerProps) {
+  return <>
+            {buttons.map((button) => {
+              const overlay = overlays[button.id] ?? {};
+              const mainLabel = getMainLabel(button);
+              const isChord = isChordKind(button.kind);
+              const isTreble = button.kind === "treble-note";
+              const isTrebleAccidental =
+                isTreble && isAccidentalPitch(button.pitchClass);
+              const isPianoKey =
+                button.visualShape?.startsWith("piano-") ?? false;
+              const isPianoBlackKey = button.visualShape === "piano-black-key";
+              const sequenceLabels = getSequenceLabelsForButton(
+                sequenceSteps,
+                button.id,
+              );
+              const scaleFinderLabels = showScaleFinderNumbers
+                ? finderLabelsForButton(scaleFinderButtons, button.id)
+                : "";
+              const finderMatch = finderButtonIds.has(button.id) || progressionPreviewButtonIds.has(button.id);
+              const abcMatch =
+                abcActiveButtonIdSet.has(button.id) ||
+                bassPatternActiveButtonIdSet.has(button.id) ||
+                harmonyProgressionActiveButtonIdSet.has(button.id);
+              const primaryFinderMatch =
+                stradellaChordFinderActive &&
+                stradellaPrimaryFinderButtonIds.has(button.id);
+              const rootBassFinderMatch =
+                stradellaChordFinderActive &&
+                stradellaRootBassFinderButtonIds.has(button.id);
+
+              const fontSize =
+                chordLabelMode === "chord-tones" && isChord
+                  ? Math.max(7, labelFontSize * 0.75)
+                  : labelFontSize;
+
+              return (
+                <g
+                  key={button.id}
+                  className="button-group"
+                  onClick={(event) => {
+                    event.stopPropagation();
+                    toggleButton(button);
+                  }}
+                >
+                  {isPianoKey ? (
+                    <>
+                      <rect
+                        x={button.x - (button.width ?? buttonSize * 2) / 2}
+                        y={button.y - (button.height ?? buttonSize * 2) / 2}
+                        width={button.width ?? buttonSize * 2}
+                        height={button.height ?? buttonSize * 2}
+                        rx={isPianoBlackKey ? 5 : 7}
+                        className={[
+                          "button",
+                          "piano-key",
+                          isPianoBlackKey
+                            ? "piano-black-key"
+                            : "piano-white-key",
+                          overlay.selected ? "selected" : "",
+                          finderMatch ? "finder-match" : "",
+                          abcMatch ? "abc-match" : "",
+                          primaryFinderMatch ? "finder-primary" : "",
+                          rootBassFinderMatch ? "finder-root-bass" : "",
+                          sequenceLabels || scaleFinderLabels
+                            ? "in-sequence"
+                            : "",
+                        ].join(" ")}
+                      />
+                      {(finderMatch || abcMatch) && (
+                        <rect
+                          x={
+                            button.x - (button.width ?? buttonSize * 2) / 2 + 3
+                          }
+                          y={
+                            button.y - (button.height ?? buttonSize * 2) / 2 + 3
+                          }
+                          width={(button.width ?? buttonSize * 2) - 6}
+                          height={(button.height ?? buttonSize * 2) - 6}
+                          rx={isPianoBlackKey ? 4 : 6}
+                          className={
+                            abcMatch
+                              ? "finder-ring abc-ring"
+                              : rootBassFinderMatch
+                                ? "finder-ring finder-root-bass-ring"
+                                : primaryFinderMatch
+                                  ? "finder-ring finder-primary-ring"
+                                  : "finder-ring"
+                          }
+                        />
+                      )}
+                    </>
+                  ) : (
+                    <>
+                      <circle
+                        cx={button.x}
+                        cy={button.y}
+                        r={buttonSize}
+                        className={[
+                          "button",
+                          isChord ? "chord" : "note",
+                          isTreble ? "treble-button" : "",
+                          isTrebleAccidental ? "treble-accidental" : "",
+                          overlay.selected ? "selected" : "",
+                          button.isReference ? "reference" : "",
+                          finderMatch ? "finder-match" : "",
+                          abcMatch ? "abc-match" : "",
+                          primaryFinderMatch ? "finder-primary" : "",
+                          rootBassFinderMatch ? "finder-root-bass" : "",
+                          sequenceLabels || scaleFinderLabels
+                            ? "in-sequence"
+                            : "",
+                        ].join(" ")}
+                      />
+                      {(finderMatch || abcMatch) && (
+                        <circle
+                          cx={button.x}
+                          cy={button.y}
+                          r={buttonSize + 4}
+                          className={
+                            abcMatch
+                              ? "finder-ring abc-ring"
+                              : rootBassFinderMatch
+                                ? "finder-ring finder-root-bass-ring"
+                                : primaryFinderMatch
+                                  ? "finder-ring finder-primary-ring"
+                                  : "finder-ring"
+                          }
+                        />
+                      )}
+                    </>
+                  )}
+
+                  {showButtonLabels && (
+                    <text
+                      x={button.x}
+                      y={
+                        isPianoKey
+                          ? button.y +
+                            (button.height ?? buttonSize * 2) / 2 -
+                            18
+                          : button.y -
+                            (overlay.finger || sequenceLabels ? 2 : 0)
+                      }
+                      textAnchor="middle"
+                      className={[
+                        "main-label",
+                        fontClass(labelFont),
+                        isTreble ? "treble-label" : "",
+                        isTrebleAccidental || isPianoBlackKey
+                          ? "treble-accidental-label"
+                          : "",
+                        (isTrebleAccidental || isPianoBlackKey) && (finderMatch || abcMatch)
+                          ? "highlighted-accidental-label"
+                          : "",
+                      ].join(" ")}
+                      style={{ fontSize }}
+                    >
+                      {renderMusicLabel(mainLabel)}
+                    </text>
+                  )}
+                  {showSequenceNumbers && sequenceLabels && (
+                    <text
+                      x={button.x}
+                      y={numberY(button.y, buttonSize, sequenceNumberPosition)}
+                      textAnchor="middle"
+                      className="sequence-number"
+                    >
+                      {sequenceLabels}
+                    </text>
+                  )}
+                  {scaleFinderLabels && (
+                    <text
+                      x={button.x}
+                      y={numberY(button.y, buttonSize, sequenceNumberPosition)}
+                      textAnchor="middle"
+                      className="finder-number"
+                    >
+                      {scaleFinderLabels}
+                    </text>
+                  )}
+
+                  {annotationActive && !isPianoKey && (() => {
+                    const point = annotationPointForButton(button, annotationButtonAnchor);
+                    return (
+                      <circle
+                        cx={point.x}
+                        cy={point.y}
+                        r={Math.max(5, buttonSize * 0.24)}
+                        className="annotation-anchor-placeholder"
+                      />
+                    );
+                  })()}
+
+                  {annotationActive && isPianoKey && (() => {
+                    const point = annotationPointForButton(button, annotationButtonAnchor);
+                    const markerSize = Math.max(10, buttonSize * 0.42);
+                    return (
+                      <rect
+                        x={point.x - markerSize / 2}
+                        y={point.y - markerSize / 2}
+                        width={markerSize}
+                        height={markerSize}
+                        rx="4"
+                        className="annotation-anchor-placeholder"
+                      />
+                    );
+                  })()}
+
+                  {overlay.finger && (
+                    <text
+                      x={button.x}
+                      y={fingeringY(button.y, buttonSize, fingeringPosition)}
+                      textAnchor="middle"
+                      className={[
+                        "finger-label",
+                        fontClass(labelFont),
+                        isTrebleAccidental ? "treble-accidental-label" : "",
+                        isTrebleAccidental && (finderMatch || abcMatch)
+                          ? "highlighted-accidental-label"
+                          : "",
+                      ].join(" ")}
+                      style={{ fontSize: buttonSize * 0.44 }}
+                    >
+                      {overlay.finger}
+                    </text>
+                  )}
+                </g>
+              );
+            })}
+  </>;
+}
diff --git a/src/diagram/components/DiagramConnections.tsx b/src/diagram/components/DiagramConnections.tsx
new file mode 100644
--- /dev/null
+++ b/src/diagram/components/DiagramConnections.tsx
@@ -0,0 +1,90 @@
+import type { DiagramButton, SequenceArrowStyle } from "../../types";
+import type { SequenceStepWithButton } from "../../tools/sequenceTools";
+import { makeSequenceArrowPath } from "../../tools/sequenceTools";
+
+type DiagramConnectionsProps = {
+  showScaleFinderArrows: boolean;
+  scaleFinderButtons: DiagramButton[];
+  chordFinderActive: boolean;
+  chordFinderButtons: DiagramButton[];
+  showSequenceArrows: boolean;
+  sequenceStepsWithButtons: SequenceStepWithButton[];
+  buttonSize: number;
+  scaleFinderArrowStyle: SequenceArrowStyle;
+  sequenceArrowStyle: SequenceArrowStyle;
+  finderArrowheadMarkerId: string;
+  sequenceArrowheadMarkerId: string;
+};
+
+/** SVG paths follow actual button geometry, without changing any physical
+ * button IDs or inferring a sounding event from drawn connections. */
+export function DiagramConnections({
+  showScaleFinderArrows, scaleFinderButtons, chordFinderActive,
+  chordFinderButtons, showSequenceArrows, sequenceStepsWithButtons,
+  buttonSize, scaleFinderArrowStyle, sequenceArrowStyle,
+  finderArrowheadMarkerId, sequenceArrowheadMarkerId,
+}: DiagramConnectionsProps) {
+  return <>
+            {showScaleFinderArrows &&
+              scaleFinderButtons.length > 1 &&
+              scaleFinderButtons.slice(0, -1).map((fromButton, index) => {
+                const toButton = scaleFinderButtons[index + 1];
+
+                return (
+                  <path
+                    key={`scale-finder-${fromButton.id}-${toButton.id}-${index}`}
+                    d={makeSequenceArrowPath(
+                      fromButton,
+                      toButton,
+                      index,
+                      buttonSize,
+                      scaleFinderArrowStyle,
+                    )}
+                    className="finder-arrow"
+                    markerEnd={`url(#${finderArrowheadMarkerId})`}
+                  />
+                );
+              })}
+
+            {chordFinderActive &&
+              chordFinderButtons.length > 1 &&
+              chordFinderButtons.slice(0, -1).map((fromButton, index) => {
+                const toButton = chordFinderButtons[index + 1];
+
+                return (
+                  <path
+                    key={`chord-finder-${fromButton.id}-${toButton.id}-${index}`}
+                    d={makeSequenceArrowPath(
+                      fromButton,
+                      toButton,
+                      index,
+                      buttonSize,
+                      "straight",
+                    )}
+                    className="finder-arrow"
+                    markerEnd={`url(#${finderArrowheadMarkerId})`}
+                  />
+                );
+              })}
+
+            {showSequenceArrows &&
+              sequenceStepsWithButtons.slice(0, -1).map((fromStep, index) => {
+                const toStep = sequenceStepsWithButtons[index + 1];
+
+                return (
+                  <path
+                    key={`${fromStep.id}-${toStep.id}-${fromStep.step}-${toStep.step}`}
+                    d={makeSequenceArrowPath(
+                      fromStep.button,
+                      toStep.button,
+                      index,
+                      buttonSize,
+                      sequenceArrowStyle,
+                    )}
+                    className="sequence-arrow"
+                    markerEnd={`url(#${sequenceArrowheadMarkerId})`}
+                  />
+                );
+              })}
+  </>;
+}
